# ── ActivityWatch Frontend Environment Variables ─────────────────────────────
# Copy to frontend/.env and fill in real values. Never commit frontend/.env.

# Backend dashboard data endpoint
VITE_API_URL=https://aw-backend.thesama.in/api/data

# Read key — must match DASHBOARD_READ_KEY in backend/.env
VITE_ACTIVE_WATCH_API_KEY=change-me-read-key
