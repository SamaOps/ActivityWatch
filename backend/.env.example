# ── ActivityWatch Backend Environment Variables ──────────────────────────────
# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Database — PostgreSQL connection string (SQLAlchemy + psycopg driver).
# Required — the backend will not start without it.
POSTGRES_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/activity_watch
# For local development you can use SQLite instead:
# POSTGRES_URL=sqlite:///./activity.db

# Write key — devices send this when posting to /api/track.
# Injected into activity_tracker.py when the server serves it.
TRACKER_WRITE_KEY=change-me-write-key

# Read key — the dashboard sends this to read /api/data.
# Must match VITE_ACTIVE_WATCH_API_KEY in frontend/.env.
DASHBOARD_READ_KEY=change-me-read-key

# GitHub repo whose latest release provides activity_tracker.py.
GITHUB_REPO=SamaOps/ActivityWatch

# Public URL devices use to reach this server (injected into the tracker).
BACKEND_BASE_URL=https://aw-backend.thesama.in

# Token the release workflow sends to /tracker/refresh.
# Must match the REFRESH_TOKEN secret in the GitHub repo.
REFRESH_TOKEN=change-me-refresh-token
